+                    fStateChunk[i] = static_cast<char>((nib(hex[2*i]) << 4) | nib(hex[2*i+1]));
+                }
+                *(void**)ptr = fStateChunk;
+                return static_cast<intptr_t>(n);
+            }
+           #endif
